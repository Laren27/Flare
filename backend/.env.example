# Copy to backend/.env and fill in. Never commit the real .env (Ch. 22).

# psycopg 3 driver -- ADR-018. Note the "+psycopg" suffix; "postgresql://"
# alone would select psycopg2, which is not installed.
#
# The password is part of a URL, so reserved characters MUST be percent-encoded
# or the URL is silently mis-parsed -- an unescaped "@" ends the credentials
# section, and the rest of the password gets read as the hostname:
#
#     @ -> %40    : -> %3A    / -> %2F    # -> %23    ? -> %3F    % -> %25
#
# Encode one with:
#     python -c "import urllib.parse,getpass; print(urllib.parse.quote(getpass.getpass(), safe=''))"
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/flare

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME

JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# ---------------------------------------------------------------------------
# AI summary -- ADR-005, ADR-013, ADR-024.
#
# THIS FILE IS COMMITTED. Real keys go in backend/.env, which is gitignored.
# Leave every secret here as CHANGE_ME.
#
# The service works with no key at all: it reports ai_status='skipped' and
# dispatch proceeds untouched, because the AI call is never on the critical
# path. You only need a key to demo the enrichment itself.
#
# AI_PROVIDER picks one provider; there is no automatic failover between them
# (ADR-024). If the Gemini free tier's daily quota runs out, change this one
# line to "groq" and fill GROQ_API_KEY.
AI_PROVIDER=gemini

GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-3.5-flash-lite

# Paste the model id exactly as the Groq console lists it.
GROQ_API_KEY=CHANGE_ME
GROQ_MODEL=CHANGE_ME

# Hard ceiling on the call, in seconds (ADR-013). Past this the incident keeps
# {unspecified, medium} and the degradation is logged.
AI_TIMEOUT_SECONDS=3.0