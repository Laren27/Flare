# Copy to backend/.env and fill in. Never commit the real .env (Ch. 22).

# psycopg 3 driver -- ADR-018. Note the "+psycopg" suffix; "postgresql://"
# alone would select psycopg2, which is not installed.
#
# The password is part of a URL, so reserved characters MUST be percent-encoded
# or the URL is silently mis-parsed -- an unescaped "@" ends the credentials
# section, and the rest of the password gets read as the hostname:
#
#     @ -> %40    : -> %3A    / -> %2F    # -> %23    ? -> %3F    % -> %25
#
# Encode one with:
#     python -c "import urllib.parse,getpass; print(urllib.parse.quote(getpass.getpass(), safe=''))"
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/flare

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME

JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
